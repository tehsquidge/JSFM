{
  "name": "FMJS",
  "version": "0.1.0",
  "author": "Liam Kerr",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "package": "vite build && node tasks.mjs build",
    "updatePresets": "node tasks.mjs updatePresets",
    "generatePresetSchemaFromTS": "typescript-json-schema src/js/types/Preset.ts PresetInterface -o src/js/preset.schema.json"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "deepmerge": "^4.3.1",
    "nw-builder": "^4.21.4",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "typescript-json-schema": "^0.68.0",
    "vite": "^8.3.2"
  }
}
